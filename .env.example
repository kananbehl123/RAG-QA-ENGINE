# OpenAI API Key (Required for text-embedding-3-small and gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Vector Store Configuration (lancedb or chromadb)
VECTOR_DB_TYPE=lancedb
LANCE_DB_PATH=./data/lancedb
CHROMA_DB_PATH=./data/chromadb

# Embedding Model Settings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval & QA Parameters
TOP_K=5
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Telemetry & Logging
LOG_LEVEL=INFO
DEBUG=True
